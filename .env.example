PORT=3001
NODE_ENV=development

# Local MongoDB for development
MONGO_URI=mongodb://localhost:27017/evalai

# Replace before production use
JWT_SECRET=change-me-in-production

# Google Cloud Vision
# Use either GOOGLE_APPLICATION_CREDENTIALS or the explicit env vars below.
# GOOGLE_APPLICATION_CREDENTIALS=./config/google-vision.json
# GOOGLE_PROJECT_ID=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# Gemini API used by backend evaluation proxy
GEMINI_API_KEY=

# Email (Resend HTTPS API)
RESEND_API_KEY=re_your_api_key
SENDER_EMAIL=onboarding@resend.dev

# Razorpay credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS origins (comma-separated)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
